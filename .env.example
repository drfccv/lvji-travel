# Docker 编排变量（首次使用前请修改为自定义值）
DB_USER=
DB_PASS=
APP_PORT=4173
# 数据加密密钥（必填）；用于加密数据库中的 API Key，部署后请勿更改
APP_ENCRYPTION_KEY=

# 本地开发数据库连接（Docker 部署时此变量不生效）
DATABASE_URL=postgresql://username:password@127.0.0.1:5432/change-me
DATABASE_POOL_SIZE=10

# ── AI 提供商 ──────────────────────────────────────────────────────
# 数据库 ai_settings 表未配置时的兜底值；留空则需在页面设置中保存
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ── MCP 服务（服务地址有代码内默认值，通常无需填写）───────────────
# 12306 火车票 MCP（需自行部署服务端）
MCP_12306_URL=
MCP_12306_API_KEY=

# SearXNG 全能搜索 MCP（需自行部署服务端）
MCP_SEARXNG_URL=

# 高德地图 MCP
AMAP_WEB_SERVICE_KEY=

# 全能搜索 MCP
TAVILY_API_KEY=

# 订票 MCP（DIDA_API_KEY 与 ROLLINGGO_API_KEY 二选一即可）
DIDA_API_KEY=
ROLLINGGO_API_KEY=

# ── Headroom 上下文压缩代理 ────────────────────────────────────────
# 留空则直连 AI 提供商
# Docker 编排下：http://headroom:8787/v1（配合 --profile headroom 使用）
# 本地开发下：http://127.0.0.1:8787/v1
HEADROOM_PROXY=

# ── 其他 ────────────────────────────────────────────────────────────
# UAPI 天气查询；留空时使用访客额度
UAPI_API_KEY=
